# Nuxt public client config — your Convex deployment URLs.
# Get these from `bunx convex dev` output (the .cloud and .site URLs).
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NUXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# NOTE: Auth secrets do NOT go here. They live on the Convex deployment,
# set via `npx convex env set ...` (see SETUP.md):
#   BETTER_AUTH_SECRET, SITE_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   RESEND_API_KEY, EMAIL_FROM,
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_*,
#   OPENROUTER_API_KEY, E2B_API_KEY, SANDBOX_PROVIDER, E2B_ALLOW_INTERNET,
#   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_BOT_USERNAME,
#   INTEGRATIONS_ENCRYPTION_KEY
